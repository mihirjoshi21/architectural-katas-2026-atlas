etry" x="55" y="1489" width="116.27999999999999" height="25.5" /></mxCell><mxCell id="c47" value="Dashed lanes: responsibility owner. Rectangles: activities. Diamond: quality decision. Cylinders: retained records. Arrows: observation and review&#10;flow." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#536878;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1525" width="1450" height="51.300000000000004" /></mxCell></root></mxGraphModel></diagram></mxfile>
